{
  "rules": {
    ".read": false,
    ".write": false,
    "_admin": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "menu": {
      "productos": {
        ".read": true
      },
      "promo": {
        ".read": true
      },
      "horario": {
        ".read": true
      },
      "meta": {
        ".read": true,
        "contadorPedidos": {
          ".write": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'titi'"
        }
      },
      "reseñas": {
        ".read": true,
        "$resena": {
          ".write": "!data.exists() && newData.hasChildren(['texto'])"
        }
      },
      "pedidos": {
        ".read": true,
        ".indexOn": [
          "codigoConsulta"
        ],
        "$pedido": {
          ".write": "!data.exists() && newData.hasChildren(['codigoConsulta', 'estado'])",
          ".validate": "newData.child('codigoConsulta').isString() && newData.child('estado').isString()"
        }
      },
      "pedidos_privados": {
        ".read": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'titi'",
        "$pedido": {
          ".write": "!data.exists() && newData.hasChildren(['codigoConsulta'])"
        }
      }
    },
    "colsabor": {
      "productos": {
        ".read": true
      },
      "promo": {
        ".read": true
      },
      "horario": {
        ".read": true
      },
      "meta": {
        ".read": true,
        "contadorPedidos": {
          ".write": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'colsabor'"
        }
      },
      "reseñas": {
        ".read": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'colsabor'",
        "$resena": {
          ".write": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'colsabor'"
        }
      },
      "pedidos": {
        ".read": true,
        ".indexOn": [
          "codigoConsulta"
        ],
        "$pedido": {
          ".write": "!data.exists() && newData.hasChildren(['codigoConsulta', 'estado'])",
          ".validate": "newData.child('codigoConsulta').isString() && newData.child('estado').isString()"
        }
      },
      "pedidos_privados": {
        ".read": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'colsabor'",
        "$pedido": {
          ".write": "!data.exists() && newData.hasChildren(['codigoConsulta'])"
        }
      }
    },
    "menu_backup": {
      ".read": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'titi'",
      ".write": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'titi'"
    },
    "dta-chanclas": {
      ".read": false,
      ".write": false,
      "productos": {
        ".read": true
      },
      "meta": {
        ".read": true
      }
    },
    "nbc-company": {
      ".read": false,
      ".write": false,
      "productos": {
        ".read": true
      },
      "meta": {
        ".read": true
      }
    }
  }
}