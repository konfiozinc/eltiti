{
  "rules": {
    "menu": {
      ".write": "auth != null",
      "productos": { ".read": true },
      "promo": { ".read": true },
      "horario": { ".read": true },
      "meta": {
        ".read": true,
        "contadorPedidos": { ".write": true }
      },
      "reseñas": { ".read": true, ".write": true },
      "pedidos": {
        ".read": true,
        ".write": true,
        ".indexOn": ["codigoConsulta"]
      },
      "pedidos_privados": {
        ".read": "auth != null",
        ".write": true
      }
    },
    "colsabor": {
      ".write": "auth != null",
      "productos": { ".read": true },
      "promo": { ".read": true },
      "horario": { ".read": true },
      "meta": {
        ".read": true,
        "contadorPedidos": { ".write": true }
      },
      "reseñas": { ".read": false, ".write": false },
      "pedidos": {
        ".read": true,
        ".write": true,
        ".indexOn": ["codigoConsulta"]
      },
      "pedidos_privados": {
        ".read": "auth != null",
        ".write": true
      }
    },
    "menu_backup": { ".read": "auth != null", ".write": true },
    "dta-chanclas": {
      ".write": "auth != null",
      "productos": { ".read": true },
      "meta": { ".read": true }
    },
    "nbc-company": {
      ".write": "auth != null",
      "productos": { ".read": true },
      "meta": { ".read": true }
    }
  }
}
