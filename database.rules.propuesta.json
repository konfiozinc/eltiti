{
  "rules": {
    ".read": false,
    ".write": false,

    "_admin": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },

    "menu": {
      "productos": { ".read": true },
      "promo": { ".read": true },
      "horario": { ".read": true },
      "meta": {
        ".read": true,
        "contadorPedidos": {
          ".write": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'titi'"
        }
      },
      "reseñas": {
        ".read": true,
        "$resena": {
          ".write": "!data.exists() && newData.hasChildren(['texto']) && newData.child('texto').isString() && newData.child('texto').val().length <= 600",
          ".validate": "newData.hasChildren(['texto'])"
        }
      },
      "pedidos": {
        ".read": true,
        ".indexOn": ["codigoConsulta"],
        "$pedido": {
          ".write": "!data.exists() && newData.hasChildren(['codigoConsulta', 'estado'])",
          ".validate": "newData.child('codigoConsulta').isString() && newData.child('codigoConsulta').val().length >= 4",
          "nombre": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "telefono": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "direccion": { ".validate": "newData.isString() && newData.val().length <= 200" }
        }
      },
      "pedidos_privados": {
        ".read": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'titi'",
        "$pedido": {
          ".write": "!data.exists() && newData.hasChildren(['codigoConsulta'])",
          ".validate": "newData.child('codigoConsulta').isString()"
        }
      }
    },

    "colsabor": {
      "productos": { ".read": true },
      "promo": { ".read": true },
      "horario": { ".read": true },
      "meta": {
        ".read": true,
        "contadorPedidos": {
          ".write": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'colsabor'"
        }
      },
      "reseñas": {
        ".read": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'colsabor'",
        "$resena": {
          ".write": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'colsabor'"
        }
      },
      "pedidos": {
        ".read": true,
        ".indexOn": ["codigoConsulta"],
        "$pedido": {
          ".write": "!data.exists() && newData.hasChildren(['codigoConsulta', 'estado'])",
          ".validate": "newData.child('codigoConsulta').isString() && newData.child('codigoConsulta').val().length >= 4",
          "nombre": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "telefono": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "direccion": { ".validate": "newData.isString() && newData.val().length <= 200" }
        }
      },
      "pedidos_privados": {
        ".read": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'colsabor'",
        "$pedido": {
          ".write": "!data.exists() && newData.hasChildren(['codigoConsulta'])",
          ".validate": "newData.child('codigoConsulta').isString()"
        }
      }
    },

    "menu_backup": {
      ".read": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'titi'",
      ".write": "auth != null && root.child('_admin').child(auth.uid).child('negocio').val() == 'titi'"
    },

    "dta-chanclas": {
      ".read": false,
      ".write": false,
      "productos": { ".read": true },
      "meta": { ".read": true }
    },

    "nbc-company": {
      ".read": false,
      ".write": false,
      "productos": { ".read": true },
      "meta": { ".read": true }
    }
  }
}
